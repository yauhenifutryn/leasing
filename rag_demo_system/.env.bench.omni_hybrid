# Benchmark profile: omni_hybrid
# Qwen3-Omni hybrid mode: audio-in/audio-out with RAG context injection
# IMPORTANT: Stop the split pipeline brain model before starting the Omni sidecar
# (supervisorctl stop qwen && supervisorctl start qwen3_omni)
# Omni needs ~79 GB VRAM; cannot co-host with Qwen3.5-35B (~70 GB)
BENCH_PROFILE=omni_hybrid
BENCH_BACKEND=our_rag
VOICE_PROVIDER=qwen3_omni
QWEN3_OMNI_BASE_URL=http://127.0.0.1:8002
# STT still needed for RAG query extraction (runs before Omni call)
SENSEVOICE_BASE_URL=http://127.0.0.1:8001
# Omni handles both LLM and TTS internally; these are ignored in Omni path
# but present for profile completeness
BENCH_STT_PROVIDER=whisper
BENCH_TTS_PROVIDER=qwen3_tts
