RAG_LLM_BASE_URL=http://127.0.0.1:8001/v1
RAG_LLM_MODEL=Qwen/Qwen3-30B-A3B
RAG_LLM_FAST_BASE_URL=http://127.0.0.1:8001/v1
RAG_LLM_FAST_MODEL=Qwen/Qwen3-30B-A3B

DIFY_API_BASE_URL=https://api.dify.ai/v1
DIFY_API_KEY=

VOSK_BASE_URL=http://127.0.0.1:50010
VOSK_TTS_BASE_URL=http://127.0.0.1:50011
VOSK_MODEL_PATH=/workspace/leasing/models/vosk-model-small-ru-0.22
VOSK_TTS_MODEL_NAME=vosk-model-tts-ru-0.9-multi
VOSK_TTS_SAMPLE_RATE_HZ=22050

STACK_MODE=docker
RAG_LAUNCH_MODE=supervisor
STACK_VOICE_PROFILE=oss_russian
STACK_START_FRONTEND=0
STACK_QWEN_CMD=
STACK_VOSK_CMD=./.venv-voice-oss/bin/python -m uvicorn services.vosk_server:app --host 0.0.0.0 --port 50010
STACK_VOSK_TTS_CMD=./.venv-voice-oss/bin/python -m uvicorn services.vosk_tts_server:app --host 0.0.0.0 --port 50011

PORT=8787
